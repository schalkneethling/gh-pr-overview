{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "default",
  "packageManager": "pnpm",
  "integrations": [
    "editorconfig",
    "html-validate",
    "github-repository-controls",
    "stylelint",
    "stylelint-standard",
    "stylelint-order",
    "stylelint-baseline",
    "stylelint-logical-css",
    "css-property-type-validator"
  ],
  "scripts": {
    "lint": true,
    "lint:fix": true,
    "quality": true
  },
  "ai": [
    {
      "id": "skill-frontend-engineering"
    },
    {
      "id": "skill-frontend-security"
    },
    {
      "id": "skill-frontend-testing"
    },
    {
      "id": "skill-more-secure-dependabot-config"
    }
  ],
  "integrationOptions": {
    "stylelint-baseline": {
      "available": "newly",
      "severity": "warning"
    },
    "github-repository-controls": {
      "repository": "schalkneethling/gh-pr-overview",
      "defaultBranch": "main",
      "requiredChecks": [
        "quality"
      ],
      "mergeMethods": [
        "squash"
      ],
      "wiki": false,
      "projects": false,
      "autoMerge": true,
      "deleteBranchOnMerge": true,
      "updateBranch": true,
      "dependabotEcosystems": [
        "npm",
        "github-actions"
      ],
      "codeqlLanguages": [
        "actions",
        "javascript-typescript"
      ],
      "codeqlQuerySuite": "extended",
      "releaseEnvironment": null
    }
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gh-pr-overview",
  "main": "./worker/index.ts",
  // workerd bundled with @cloudflare/vite-plugin 1.63 supports up to 2026-10-06.
  "compatibility_date": "2026-10-06",
  // Required by varlock's runtime.
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev URL is the app's address; Cloudflare Access protects it.
  "workers_dev": true,
  // Per-version preview URLs would be extra addresses to protect; not needed here.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
